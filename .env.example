# Local development defaults. Copy to .env and adjust.
PORT=3000
HOST=127.0.0.1

# Canonical public URI of this server. Must be the externally reachable URL once
# OAuth 2.1 resource indicators are wired up (milestone 3).
PUBLIC_URL=http://127.0.0.1:3000

# OAuth 2.1 is enforced unless this is exactly "false". Turn it off only for local
# iteration — the Alexa+ requirement is that /mcp returns 401 when unauthenticated.
AUTH_ENABLED=true

# Where household state is persisted.
STATE_PATH=.state/households.json

# Content-addressed translation cache. Empty keeps it in memory only.
TRANSLATION_CACHE_PATH=.state/translations.json

# "echo" runs offline and does not translate — it marks text so a wrong-language
# rendering is obvious. Switch to "bedrock" once model access is granted.
LANGUAGE_PROVIDER=echo

AWS_REGION=us-west-2
AWS_PROFILE=alexa-hackathon

# Bedrock has two endpoints that are NOT interchangeable — different model id forms
# and separate account entitlements:
#   runtime  us.anthropic.claude-haiku-4-5-20251001-v1:0   (inference-profile id)
#   mantle   anthropic.claude-haiku-4-5                    (bare id)
# `runtime` is the default because it is what this account is entitled to.
BEDROCK_ENDPOINT=runtime
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# output_config.effort — leave empty. Haiku 4.5 rejects it outright.
BEDROCK_EFFORT=

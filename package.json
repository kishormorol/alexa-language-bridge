{
  "name": "alexa-language-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets a non-English-speaking household member use an Alexa+ device in their own language",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview:card": "tsx scripts/preview-card.ts",
    "sim": "tsx src/sim/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
